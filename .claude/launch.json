{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "dist",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/serve-dist.mjs", "8082"],
      "port": 8082
    },
    {
      "name": "dist-orexis",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/serve-dist.mjs", "8083", "--base", "/orexis"],
      "port": 8083,
      "url": "http://localhost:8083"
    }
  ]
}
